---
export const prerender = true;

import Footer from "@components/generalUtilities/Footer.astro";
import Navigation from "@components/generalUtilities/Navigation.astro";
import unsaacBorder from "@assets/unsaacBorder.png";
import { ClientRouter } from "astro:transitions";

// src/layouts/Layout.astro
interface Props {
  title: string;
  isHeroPage?: boolean;
}

const { title, isHeroPage = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sitio web oficial de la Federación Universitaria Cusco, representando a los estudiantes con compromiso y transparencia." />
    <meta name="author" content="Oriol F. Palacios Durand" />
    <meta property="og:title" content="Federación Universitaria Cusco" />
    <meta property="og:description" content="Representamos a los estudiantes universitarios en Cusco con compromiso y transparencia." />
    <meta property="og:image" content="https://federacion-universitaria-cusco.netlify.app/favicon.png" />
    <meta property="og:url" content="https://federacion-universitaria-cusco.netlify.app/" />
    <meta name="twitter:title" content="Federación Universitaria Cusco" />
    <meta name="twitter:description" content="Somos la Federación Universitaria Cusco, representando a los estudiantes con transparencia y compromiso." />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#991b1b" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="google-site-verification" content="JBmJV5m9Hmpa1gV5qRvgLdCvUaL9OtNRVsCO-dDWaJY" />
    <link rel="preload" href={unsaacBorder.src} as="image" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="relative">
    <Navigation isHeroPage={isHeroPage}/>
    <slot />
    <Footer isHeroPage={isHeroPage} />
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;
  .swiper-button-next:after {
    color: #000;
  }
  .swiper-button-prev:after {
    color: #000;
  }
  body {
    width: 100%;
    height: 100%;
  }
  .tl-slide .tl-slide-background {
    filter: blur(3px);
  }
  @media (max-width: 768px) {
    .tl-media-blockquote blockquote {
      font-size: medium !important;
    }
  }
</style>
